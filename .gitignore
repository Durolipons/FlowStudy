# Python
__pycache__/
*.py[cod]
*.pyo

# Database & local data (machine-specific; regenerated by the pipeline)
data/library.db
data/*.db-wal
data/*.db-shm
data/*.tmp
data/*.bak*
data/van_nostrand_cache.json
*.db

# Machine-specific config (copy config.example.json -> config.json and edit)
config.json

# Generated output (back up externally)
exports/*
!exports/.gitkeep
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep

# Secrets
.env
*.key

# OS noise already handled at scan time, ignored here as well
Thumbs.db
*.DS_Store
.DS_Store
